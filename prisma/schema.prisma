// BayBayt — Prisma schema (Postgres)
// Mirrors src/lib/types.ts so the API returns objects the UI already expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String
  passwordHash    String
  role            String   @default("buyer") // buyer | owner | agent | builder | admin
  city            String?
  avatar          String?
  companyName     String?
  reraNumber      String?
  // --- Preferred Agent directory profile (only meaningful for role='agent') ---
  // isPreferredAgent is admin-curated: it decides who appears in the public
  // "BayBayt Preferred Agents" directory. The rest are the agent's marketing
  // profile — most self-editable by the agent, except the editorial ones
  // (agentBadge, agentRating) which stay admin-controlled.
  isPreferredAgent Boolean @default(false)
  agencyLogo      String?
  agentBadge      String?  // editorial, admin-set (e.g. "BayBayt Preferred")
  agentRating     Float?   // editorial, admin-set
  operatingSince  Int?
  experienceYears Int?
  buyersServed    String?
  specializations String[] @default([])
  areasServed     String[] @default([])
  languages       String[] @default([])
  agentAbout      String?
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  blockedReason   String?
  blockedAt       String?
  lastActive      String?
  // Free-tier listing allowance consumed. New accounts get FREE_LISTINGS (1)
  // free listings before an active paid plan is required. Admins are exempt.
  freeListingsUsed Int     @default(0)
  createdAt       DateTime @default(now())

  properties       Property[]         @relation("PostedProperties")
  submittedProjects FeaturedProject[] @relation("SubmittedProjects")
  inquiriesSent    Inquiry[]          @relation("BuyerInquiries")
  inquiriesRecv    Inquiry[]          @relation("SellerInquiries")
  subscriptions    Subscription[]

  @@index([role])
  @@index([isPreferredAgent])
}

// A purchased listing pack. Each row is one Razorpay payment granting
// `listingsQuota` listings valid until `expiresAt` (1 year). Quota is consumed
// on listing creation (credit-pack model): `listingsUsed` only ever increments,
// deleting a listing does not refund. Active packs stack — a user's remaining
// allowance is the free-tier remainder plus the sum of (quota - used) across all
// active, non-expired packs.
model Subscription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String    // plan_100 | plan_365
  listingsQuota     Int
  listingsUsed      Int       @default(0)
  amount            Int       // amount charged, in paise
  currency          String    @default("INR")
  status            String    @default("created") // created | active | failed
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime  @default(now())
  activatedAt       DateTime?
  expiresAt         DateTime?

  @@index([userId])
  @@index([status])
}

model Property {
  id                   String   @id @default(cuid())
  title                String
  tagline              String?
  listingType          String   // buy | rent | pg | plot | commercial
  commercialListingType String? // commercial only: rent | sale
  category             String
  city                 String
  locality             String
  subLocality          String?
  price                Int
  priceFormatted       String
  pricePerSqFt         Int?
  maintenance          Int?
  bhk                  Int?
  bathrooms            Int      @default(1)
  balconies            Int?
  carpetAreaSqFt       Int      @default(0)
  superBuiltUpAreaSqFt Int?
  furnishing           String   @default("Unfurnished")
  floor                Int?
  totalFloors          Int?
  facing               String?
  constructionStatus   String   @default("Ready to Move")
  possessionDate       String?
  ageOfProperty        String?
  reraId               String?
  reraApproved         Boolean  @default(false)
  isVerified           Boolean  @default(false)
  verificationStatus   String   @default("pending") // approved | pending | rejected | under_review
  rejectionReason      String?
  inquiriesCount       Int      @default(0)
  viewsCount           Int      @default(0)
  documentsSubmitted   String[]
  isFeatured           Boolean  @default(false)
  isExclusiveOwner     Boolean  @default(false)
  priceDrop            Boolean  @default(false)
  images               String[]
  floorPlanImage       String?
  description          String
  amenities            String[]
  postedBy             Json     // embedded contact { name, type, phone, ... }
  nearbyLandmarks      Json?
  coordinates          Json?
  createdAt            DateTime @default(now())

  postedByUserId       String?
  postedByUser         User?    @relation("PostedProperties", fields: [postedByUserId], references: [id], onDelete: SetNull)

  inquiries            Inquiry[]
  views                PropertyView[]

  @@index([city])
  @@index([listingType])
  @@index([verificationStatus])
  @@index([postedByUserId])
}

// One row per real property-page view. Powers the dashboard trend charts
// (views / unique visitors over time). ownerUserId is denormalized from the
// property so owner-scoped analytics avoid a join; visitorKey is an anonymous
// stable per-browser id used to count unique visitors.
model PropertyView {
  id           String   @id @default(cuid())
  propertyId   String
  ownerUserId  String?
  viewerUserId String?
  visitorKey   String
  createdAt    DateTime @default(now())

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([ownerUserId])
  @@index([createdAt])
}

model Inquiry {
  id            String   @id @default(cuid())
  propertyId    String
  propertyTitle String
  sellerUserId  String?
  buyerUserId   String?
  buyerName     String
  buyerPhone    String
  buyerEmail    String
  message       String
  preferredTime String?
  status        String   @default("new") // new | contacted | scheduled | closed
  createdAt     DateTime @default(now())

  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer         User?    @relation("BuyerInquiries", fields: [buyerUserId], references: [id], onDelete: SetNull)
  seller        User?    @relation("SellerInquiries", fields: [sellerUserId], references: [id], onDelete: SetNull)

  @@index([sellerUserId])
  @@index([buyerUserId])
  @@index([propertyId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  actorName   String
  actorRole   String
  details     String
  targetTitle String?
  targetId    String?
  severity    String   @default("info") // info | success | warning | danger
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// --- Catalog content (mirrors src/lib/buildersData.ts, homeSectionsData.ts, collectionsData.ts) ---
// These power the Builders, Projects, Agents and Collections pages. IDs are kept as
// the human-readable slugs from the source data so existing links keep working.

model Builder {
  id                     String   @id // slug, e.g. "godrej-properties"
  name                   String
  slug                   String   @unique
  logo                   String
  bannerImage            String
  tagline                String
  badge                  String
  experienceYears        Int
  experienceText         String
  establishedYear        Int
  projectsDeliveredCount Int
  projectsDeliveredText  String
  ongoingProjectsCount   Int
  ongoingProjectsText    String
  totalSqFtDelivered     String
  rating                 Float
  reviewsCount           Int
  headquarters           String
  reraRegistrationNumber String
  citiesPresent          String[]
  about                  String
  specialties            String[]
  awards                 String[]
  contactPhone           String
  contactEmail           String
  website                String
  projects               Json     // BuilderProject[] (nested, incl. associatedPropertyIds)
  createdAt              DateTime @default(now())
}

model FeaturedProject {
  id                       String   @id // slug, e.g. "proj-dlf-camellias"
  section                  String   @default("featured") // featured | top
  name                     String
  builderName              String
  builderLogo              String
  builderId                String?
  city                     String
  locality                 String
  address                  String?
  marketedBy               String
  bhkConfig                String
  priceFormatted           String
  minPrice                 Int
  maxPrice                 Int?
  pricePerSqFt             String?
  image                    String
  galleryImages            String[]
  status                   String
  tag                      String?
  reraNumber               String?
  possessionDate           String?
  launchDate               String?
  totalAreaAcres           String?
  totalTowers              Int?
  totalUnits               Int?
  openSpacePercent         String?
  description              String?
  highlights               String[]
  amenities                String[]
  floorPlans               Json?    // ProjectFloorPlan[]
  nearbyLandmarks          Json?    // ProjectNearby[]
  builderExperience        String?
  builderDeliveredProjects Int?
  // --- Submission & moderation (Option C: builders submit, admins approve) ---
  // submissionStatus defaults to "approved" so curated/seeded catalog projects
  // are live immediately. Builder submissions via POST /api/projects explicitly
  // start "pending" and only surface publicly once an admin approves them.
  submissionStatus         String   @default("approved") // approved | pending | rejected | under_review
  rejectionReason          String?
  submittedByUserId        String?
  submittedByUser          User?    @relation("SubmittedProjects", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())

  @@index([city])
  @@index([section])
  @@index([submissionStatus])
  @@index([submittedByUserId])
}

// NOTE: Preferred Agents are no longer a standalone catalog table. They are
// Users with role='agent' and isPreferredAgent=true (see the User model).
// This keeps a single source of truth: an agent's directory profile, login
// account, and real listings are one record.

// Admin-curated "Popular Localities" home-page tiles. Only the display metadata
// (name + thumbnail) lives here; the property count and price-per-sqft range are
// computed live from approved Property rows whose `locality` matches `name`
// (case-insensitive) in the same `city`. A tile with zero matching approved
// listings is hidden on the site (pure inventory-gated display).
model Locality {
  id        String   @id @default(cuid())
  city      String
  name      String
  thumbnail String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, name])
  @@index([city])
}

model Collection {
  id                String   @id // slug, e.g. "zero-brokerage"
  title             String
  subtitle          String
  tag               String
  tagColor          String
  iconName          String
  heroImage         String
  badge             String
  actionText        String
  overview          String
  keyHighlights     Json     // { title, description }[]
  filters           Json     // CuratedCollection["filters"]
  recommendedCities String[]
  faqs              Json     // { question, answer }[]
  createdAt         DateTime @default(now())
}
