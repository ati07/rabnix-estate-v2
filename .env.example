# ---------------------------------------------------------------------------
# BayBayt — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# SITE_URL: Canonical public URL of the site, used as metadataBase to turn
# relative Open Graph / Twitter image paths into absolute URLs for social-card
# previews. Set this to your production domain (no trailing slash),
# e.g. https://baybayt.com. If unset, the app falls back to http://localhost:3000.
SITE_URL="https://your-domain.com"

# DATABASE_URL: PostgreSQL connection string used by Prisma.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgres://postgres:password@localhost:5432/baybayt_estate"

# JWT_SECRET: Secret used to sign session JWTs (jose, HS256).
# Generate a strong random value, e.g.:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# GEMINI_API_KEY: Google Gemini API key for the AI property advisor
# (src/app/api/gemini/advisor). Optional — the advisor feature is disabled
# without it, but the rest of the app works.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BLOB_READ_WRITE_TOKEN: Vercel Blob token used by /api/upload for image
# uploads (property photos, profile avatars) IN PRODUCTION. Local development
# writes uploads to public/uploads/ instead, so this token is NOT required for
# `npm run dev`. On Vercel it is injected automatically once a Blob store is
# connected to the project (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX"

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Razorpay API credentials used by the
# listing-plan billing flow (/api/billing/*). Get them from the Razorpay
# Dashboard → Settings → API Keys (use test keys during development).
# IN DEVELOPMENT: if these are left unset, the buy flow runs in a test-mode
# bypass that simulates a successful payment (no real charge) so the whole
# plan/quota flow can be exercised locally. IN PRODUCTION these are REQUIRED —
# without them the buy buttons return an error.
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"

# SMS / OTP delivery. Used to deliver mobile OTPs for phone sign-in and
# contact-reveal verification (src/lib/sms.ts). IF SMS_PROVIDER IS UNSET, the
# app falls back to "console delivery": the OTP is logged to the server console
# and returned as a dev code in the API response (never in production) so the
# whole flow is testable without an SMS account.
#
# Provider A — renflair (DLT-free, current live provider). Set:
#   SMS_PROVIDER=renflair
#   RENFLAIR_API_KEY=<API key from the Renflair dashboard>
#
# Provider B — msg91 (India-first, cheapest, but DLT-required). Set
# SMS_PROVIDER=msg91 and the two MSG91 values below. NOTE (India): MSG91 needs
# DLT registration — a registered Header (sender id) and an approved OTP
# template containing an ##OTP## variable — before any real SMS will deliver.
# The template's id is MSG91_OTP_TEMPLATE_ID.
SMS_PROVIDER=""
RENFLAIR_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# ---------------------------------------------------------------------------
# Google Maps Platform (interactive maps)
# ---------------------------------------------------------------------------
# GOOGLE_MAP_KEY: Google Maps key for the property-detail map, the "nearby places"
# panel, and the /properties/map discovery map. The Maps JavaScript API runs in
# the BROWSER, so this value is inlined into the client bundle (via the `env` map
# in next.config.ts). It MUST therefore be a locked-down browser key — in Google
# Cloud Console → Credentials:
#   • Application restriction: HTTP referrers → your origins only
#       e.g. https://your-domain.com/*  and  http://localhost:3000/*
#   • API restriction: enable ONLY "Maps JavaScript API" and "Places API (New)".
# If this is unset, maps degrade gracefully: the UI shows the address plus an
# "Open in Google Maps" link instead of an interactive map. No other feature
# depends on it.
GOOGLE_MAP_KEY=""

# GOOGLE_MAP_ID: Optional Map ID (Cloud-based maps styling). Advanced Markers
# require a Map ID; if unset the app uses Google's built-in 'DEMO_MAP_ID', which
# renders fine for development. Create your own at Google Maps Platform → Map
# Management for production styling. Also inlined client-side via next.config.ts.
GOOGLE_MAP_ID=""

# GOOGLE_MAPS_SERVER_API_KEY: Optional SERVER-side key used ONLY by the one-off
# coordinate backfill script (scripts/backfill-coordinates.mjs), which geocodes
# existing listings so they can appear on the discovery map. It needs the
# "Geocoding API" enabled. If unset, the script falls back to GOOGLE_MAP_KEY.
# NOTE: a single key can't be both HTTP-referrer-restricted (for the browser) and
# IP-restricted (for a server script) at once, so for a real backfill you may want
# a separate key here. NOT required for the app to run.
GOOGLE_MAPS_SERVER_API_KEY=""
